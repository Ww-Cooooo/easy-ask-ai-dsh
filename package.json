{
  "name": "eh3-dsh-easy-ask-ai",
  "version": "0.4.10",
  "private": true,
  "description": "Conversation-following understanding, source evidence and human-approved changes inside DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "dsh": "0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "lib/types/*.d.ts",
    "lib/types/types.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "licenses",
    "VALIDATION.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@antv/g6": "^5.1.1",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@gsap/react": "^2.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "antd": "^6.7.0",
    "esbuild": "^0.25.0",
    "fabric": "^7.4.0",
    "gsap": "^3.15.1",
    "image-size": "^2.1.0",
    "lenis": "^1.3.27",
    "react-markdown": "^10.1.0",
    "typescript": "^5.9.0",
    "zod": "4.6.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ww-Cooooo/easy-ask-ai-dsh.git"
  },
  "homepage": "https://github.com/Ww-Cooooo/easy-ask-ai-dsh#readme",
  "bugs": {
    "url": "https://github.com/Ww-Cooooo/easy-ask-ai-dsh/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "requirements",
    "clarification"
  ]
}
